{
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://sidis-api.onrender.com/api/:path*" },
    { "source": "/socket.io/:path*", "destination": "https://sidis-api.onrender.com/socket.io/:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite"
}
